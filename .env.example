# =============================================================================
# MUAR-SFC .env.example
# Copie para `.env` (ou exporte como MUAR_*) e ajuste conforme o experimento.
# Listas devem usar JSON (ex.: MUAR_CRASH_AT=[125,155,185]).
# =============================================================================

# --- Orquestração ---
MUAR_ALG=replic
MUAR_TOPOLOGY=luxembourgv2
MUAR_N_SESSIONS=50
MUAR_N_PLAYERS=4
MUAR_SFC_LIFETIME=120
MUAR_VERBOSE=True
MUAR_ECO_EFFI_RATIO=0.7

# --- Heterogeneidade de Serviços (F2) ---
# Lista de serviços e pesos relativos (a soma não precisa ser 1).
# Para o baseline 100% MUAR, use: MUAR_SERVICE_MIX=muar / MUAR_SERVICE_WEIGHTS=1.0
MUAR_SERVICE_MIX=muar,streaming,voip,iot
MUAR_SERVICE_WEIGHTS=0.7,0.1,0.1,0.1

# --- Compartilhamento / SFC ---
MUAR_SHARE=True
MUAR_SHAREBAND=False
MUAR_ALLOW_DELAY=False
MUAR_BACKUP=True
MUAR_MOBILITY=True

# --- Confiabilidade e Falhas ---
MUAR_AVA=0.99
MUAR_NUMBER_OF_FAILS=3
MUAR_MIN_FAIL_DURATION=20.0
MUAR_CRASH_AT=[125,155,185]